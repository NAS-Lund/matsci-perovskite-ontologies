@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obs:     <https://growgraph.dev/ontologies/observation#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix qqval:   <https://growgraph.dev/ontologies/qqval#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Shapes graph header
#
# Closed-world validation companion to observation. Mirrors the
# qualified-cardinality restrictions already declared as OWL axioms
# there, so that an extraction pipeline can reject non-conforming
# LLM output outright instead of relying on open-world reasoning (which
# only ever concludes "not yet known", never "invalid").
#
# Depends on qqval-shapes for the QualifiedQuantityValue shape used by
# obs:QuantitativeObservationShape below.
#################################################################

<https://growgraph.dev/ontologies/observation-shapes> a owl:Ontology ;
    rdfs:label "observation shapes"@en ;
    dcterms:creator "growgraph.dev" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment
        """SHACL shapes mirroring the OWL cardinality/qualifier
        restrictions declared on obs:Condition, obs:QuantitativeObservation,
        and obs:QualitativeObservation in observation (>= 4.0.0)."""@en ;
    owl:versionIRI <https://growgraph.dev/ontologies/observation-shapes/2.4.0> ;
    owl:versionInfo "2.4.0" .

#################################################################
# Condition — exactly one factor, exactly one value
#################################################################

obs:ConditionShape a sh:NodeShape ;
    sh:targetClass obs:Condition ;
    sh:property
        [ sh:path obs:conditionFactor ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:class obs:ConditionFactor ;
            sh:message "Condition requires exactly one obs:conditionFactor of type obs:ConditionFactor."@en
        ] ,
        [ sh:path obs:conditionValue ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:class obs:ConditionValue ;
            sh:message "Condition requires exactly one obs:conditionValue of type obs:ConditionValue."@en
        ] ;
    sh:sparql obs:NoTemporalProcessConditionConstraint .

#################################################################
# A temporal fact is not a process condition
#
# A duration is constitutive of a process, not a condition imposed on it, and
# takes life:hasDuration. Temporal factors are reachable only through
# obs:hasSetting, where a pulse width or temporal resolution is a configured
# instrument parameter.
#################################################################

obs:NoTemporalProcessConditionConstraint a sh:SPARQLConstraint ;
    rdfs:comment "A temporal factor is reachable only via obs:hasSetting (instrument configuration), never as a process or observation condition."@en ;
    sh:message "Temporal facts are not conditions: this condition is attached to a process or observation but its factor is temporal (skos:broader* obs:time). Use life:hasDuration on the process, life:hasEntityAge on the entity, or life:hasObservationDelay on the observation. Temporal instrument settings are exempt but must be reached via obs:hasSetting."@en ;
    sh:select
        """
        PREFIX obs:  <https://growgraph.dev/ontologies/observation#>
        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT $this ?factor
        WHERE {
            { ?rel rdfs:subPropertyOf* obs:hasProcessCondition . }
            UNION
            { ?rel rdfs:subPropertyOf* obs:hasObservationCondition . }
            ?subject ?rel $this .
            $this obs:conditionFactor ?factor .
            ?factor skos:broader* obs:time .
            FILTER NOT EXISTS { ?config obs:hasSetting $this . }
        }
        """ .

#################################################################
# QuantitativeObservation — result must be a qualified quantity value
#################################################################

obs:QuantitativeObservationShape a sh:NodeShape ;
    sh:targetClass obs:QuantitativeObservation ;
    rdfs:comment
        """Checked via obs:hasQuantityResult directly rather than its
        super-property sosa:hasResult, so validation does not depend on an
        RDFS/OWL reasoning pass having run first -- the extraction
        pipeline is expected to emit the concrete obs: property."""@en ;
    sh:property
        [ sh:path obs:hasQuantityResult ;
            sh:minCount 1 ;
            sh:class qqval:QualifiedQuantityValue ;
            sh:message "QuantitativeObservation requires at least one obs:hasQuantityResult whose value is a qqval:QualifiedQuantityValue (use qqval:Exact when the source value is exact)."@en
        ] ;
    sh:not [ sh:class obs:QualitativeObservation ] .

#################################################################
# QualitativeObservation — result must be a qualitative result
#################################################################

obs:QualitativeObservationShape a sh:NodeShape ;
    sh:targetClass obs:QualitativeObservation ;
    sh:property
        [ sh:path obs:hasQualitativeResult ;
            sh:minCount 1 ;
            sh:class obs:QualitativeResult ;
            sh:message "QualitativeObservation requires at least one obs:hasQualitativeResult whose value is an obs:QualitativeResult."@en
        ] ;
    sh:not [ sh:class obs:QuantitativeObservation ] .

#################################################################
# InstrumentConfiguration — one instrument, condition-typed settings
#################################################################

obs:InstrumentConfigurationShape a sh:NodeShape ;
    sh:targetClass obs:InstrumentConfiguration ;
    sh:property
        [ sh:path obs:configuredEquipment ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:message "An InstrumentConfiguration applies to at most one equipment individual; use one configuration node per instrument."@en
        ] ,
        [ sh:path obs:hasSetting ;
            sh:class obs:Condition ;
            sh:message "obs:hasSetting must point at a reified obs:Condition (factor = instrument-setting factor, value = condition value)."@en
        ] .
