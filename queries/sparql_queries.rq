PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?fwhm ?unit
WHERE {
    ?characterizationProcess a matsci:CharacterizationProcess .
    ?characterizationProcess obs:usesMethod matsci:Photoluminescence .
    ?characterizationProcess matsci:generatedObservation ?observation .

    ?observation sosa:hasFeatureOfInterest ?sample .
    ?observation sosa:observedProperty matsci:fwhmProperty .
    ?observation obs:hasQuantityResult ?value .

    ?value qudt:numericValue ?fwhm .
    ?value qudt:unit ?unit .
}


# 25. What is carrier cooling time?

PREFIX matsci: <https://growgraph.dev/ontologies/matsci#>
PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?carrierCoolingTime ?unit
WHERE {
    ?observation sosa:hasFeatureOfInterest ?sample .
    ?observation sosa:observedProperty matsci:carrierCoolingTimeProperty .
    ?observation life:hasTemporalQuantityResult ?value .

    ?value qudt:numericValue ?carrierCoolingTime .
    ?value qudt:unit ?unit .
}

# 26. What is the exciton recombination time (decays)?

PREFIX matsci: <https://growgraph.dev/ontologies/matsci#>
PREFIX obs:    <https://growgraph.dev/ontologies/observation#>
PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?decayTime ?unit
WHERE {
    ?characterizationProcess a matsci:CharacterizationProcess ;
        obs:usesMethod matsci:TRPL ;
        matsci:generatedObservation ?observation .

    ?observation sosa:hasFeatureOfInterest ?sample ;
        sosa:observedProperty matsci:decayTimeProperty ;
        life:hasTemporalQuantityResult ?value .

    ?value qudt:numericValue ?decayTime ;
        qudt:unit ?unit .
}

# 27. What is the energy transfer time into the material?

PREFIX matsci: <https://growgraph.dev/ontologies/matsci#>
PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?energyTransferTime ?unit
WHERE {
    ?observation sosa:hasFeatureOfInterest ?sample .
    ?observation sosa:observedProperty matsci:energyTransferTimeProperty .
    ?observation life:hasTemporalQuantityResult ?value .

    ?value qudt:numericValue ?energyTransferTime .
    ?value qudt:unit ?unit .
}

# 28. Do we have collective optical phenomena in the paper? If yes, what is the collective phenomenon there?

PREFIX matsci:  <https://growgraph.dev/ontologies/matsci#>
PREFIX sosa:    <http://www.w3.org/ns/sosa/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?paper ?sample ?phenomenon ?phenomenonLabel
WHERE {
    VALUES ?phenomenon {
        matsci:Superfluorescence
        matsci:Superradiance
    }

    {
        ?sample matsci:exhibitsPhenomenon ?phenomenon .

        OPTIONAL {
            ?observation sosa:hasFeatureOfInterest ?sample .
            ?observation dcterms:source ?paper .
        }
    }
    UNION
    {
        ?observation dcterms:source ?paper .
        ?observation sosa:hasFeatureOfInterest ?sample .
        ?observation sosa:observedProperty ?property .

        ?property matsci:associatedWithPhenomenon ?phenomenon .
    }

    OPTIONAL {
        ?phenomenon rdfs:label ?phenomenonLabel .
    }
}

# 29. What is the superfluorescence lifetime of the sample?

PREFIX matsci: <https://growgraph.dev/ontologies/matsci#>
PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?lifetime ?unit
WHERE {
    ?observation sosa:hasFeatureOfInterest ?sample .
    ?observation sosa:observedProperty matsci:superfluorescenceLifetimeProperty .
    ?observation life:hasTemporalQuantityResult ?value .

    ?value qudt:numericValue ?lifetime .
    ?value qudt:unit ?unit .
}


# 30. What is the superradiance lifetime of the sample?

PREFIX matsci: <https://growgraph.dev/ontologies/matsci#>
PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>

SELECT DISTINCT ?sample ?lifetime ?unit
WHERE {
    ?observation sosa:hasFeatureOfInterest ?sample .
    ?observation sosa:observedProperty matsci:superradianceLifetimeProperty .
    ?observation life:hasTemporalQuantityResult ?value .

    ?value qudt:numericValue ?lifetime .
    ?value qudt:unit ?unit .
}


# 31. How old was the sample when it was measured (elapsed time since
#     synthesis / fabrication)?
#
# The entity-scoped half of the sample-history question that Q14 answers
# process-side.

PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>
PREFIX qqval:  <https://growgraph.dev/ontologies/qqval#>

SELECT DISTINCT
    ?entity
    ?age
    ?lowerBound
    ?upperBound
    ?unit
    ?referenceProcess
WHERE {
    ?entity life:hasEntityAge ?value .

    OPTIONAL { ?value life:hasTemporalReferenceProcess ?referenceProcess . }

    OPTIONAL { ?value qudt:numericValue ?age . }
    OPTIONAL { ?value qqval:numericLowerBound ?lowerBound . }
    OPTIONAL { ?value qqval:numericUpperBound ?upperBound . }
    OPTIONAL { ?value qudt:unit ?unit . }

    FILTER(
        BOUND(?age) ||
        BOUND(?lowerBound) ||
        BOUND(?upperBound)
    )
}


# 32. At what delay after excitation was each transient result recorded?
#
# The delay is the coordinate at which the result was taken, so it is returned
# alongside the observation's own result rather than as a result itself.

PREFIX life:   <https://growgraph.dev/ontologies/lifecycle#>
PREFIX obs:    <https://growgraph.dev/ontologies/observation#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX qudt:   <http://qudt.org/schema/qudt/>
PREFIX qqval:  <https://growgraph.dev/ontologies/qqval#>

SELECT DISTINCT
    ?observation
    ?observedProperty
    ?delay
    ?delayUnit
    ?resultValue
    ?resultUnit
WHERE {
    ?observation life:hasObservationDelay ?delayValue .

    OPTIONAL { ?observation sosa:observedProperty ?observedProperty . }

    OPTIONAL { ?delayValue qudt:numericValue ?delay . }
    OPTIONAL { ?delayValue qqval:numericLowerBound ?delay . }
    OPTIONAL { ?delayValue qudt:unit ?delayUnit . }

    OPTIONAL {
        ?observation obs:hasQuantityResult ?result .
        OPTIONAL { ?result qudt:numericValue ?resultValue . }
        OPTIONAL { ?result qudt:unit ?resultUnit . }
    }

    FILTER(BOUND(?delay))
}
