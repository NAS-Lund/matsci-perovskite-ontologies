@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obs:     <https://growgraph.dev/ontologies/observation#> .
@prefix life:    <https://growgraph.dev/ontologies/lifecycle#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


<https://growgraph.dev/ontologies/lifecycle> a owl:Ontology ;
    rdfs:label "lifecycle"@en ;
    dcterms:creator "growgraph.dev" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment
        """Domain-independent module covering two orthogonal concerns: temporal
        quantities (duration, elapsed time, delay, process ordering, transient
        response) and entity lifecycle (storage, exposure, operation, aging and
        categorical entity state)."""@en ;
    skos:scopeNote
        """The prefix life: names the module, not every term's semantic
        category. Lifecycle processes use temporal quantities; that does not
        make every temporal class a lifecycle class. Specializes observation's
        Process / Observation / Phenomenon / QualitativeResult / Condition
        model, and does not import qqval -- life:TimeQuantityValue is a
        qudt:QuantityValue, and the optional tightening to
        qqval:QualifiedQuantityValue is asserted by pergres.

        Observed-property scope (process- vs entity-scoped) and result kind
        (quantitative vs qualitative) are independent axes.

        Extension contract: life:LifecycleProcess, life:TimeDependentEffect and
        life:ObservableTemporalProperty are the primary extension points.
        life:EntityLifecycleState is an open vocabulary -- the fresh/aged/stored
        trio is universal and domain ontologies add siblings.

        Temporal routes. A temporal fact takes exactly one route, determined by
        what the fact is:

          - stated extent of a process        -> life:hasDuration
          - stated age of an entity           -> life:hasEntityAge
          - stated delay of an observation    -> life:hasObservationDelay
          - temporal instrument setting       -> obs:InstrumentConfiguration
                                                 + obs:hasSetting
          - measured temporal quantity        -> life:TemporalObservation
                                                 + life:hasTemporalQuantityResult

        A temporal fact is never a process condition: a duration is
        constitutive of a process, not a condition imposed on it.
        observation-shapes.ttl enforces this."""@en ;
    owl:versionIRI <https://growgraph.dev/ontologies/lifecycle/7.0.0> ;
    owl:imports
        <https://growgraph.dev/ontologies/observation> ,
        <https://www.w3.org/ns/sosa/sosa.ttl> ,
        <http://qudt.org/3.1.4/schema/facade/qudt> ;
    owl:versionInfo "7.0.0" .

#################################################################
# Process taxonomy
#################################################################

life:LifecycleProcess a owl:Class ;
    rdfs:label "Lifecycle process"@en ;
    rdfs:comment
        """A process in an entity's post-creation lifecycle (storage,
        exposure, aging, operation, …). Duration, elapsed time, and
        temporal order are typically relevant, but the defining scope is
        the lifecycle context rather than time measurement alone."""@en ;
    rdfs:subClassOf obs:Process .

life:PostCreationProcess a owl:Class ;
    rdfs:label "Post-creation process"@en ;
    rdfs:comment "A process performed on an entity after it comes into existence, including storage, exposure, aging, and post-creation treatment."@en ;
    skos:example "synthesis"@en , "fabrication"@en ;
    rdfs:subClassOf life:LifecycleProcess .

life:StorageProcess a owl:Class ;
    rdfs:label "Storage process"@en ;
    rdfs:comment "A post-creation process in which an entity is kept under specified conditions for a specified duration."@en ;
    rdfs:subClassOf life:PostCreationProcess .

life:ExposureProcess a owl:Class ;
    rdfs:label "Exposure process"@en ;
    rdfs:comment "A process in which an entity is subjected to a specified factor for a specified duration."@en ;
    skos:example "environmental factor"@en , "optical factor"@en , "thermal factor"@en , "chemical factor"@en , "mechanical factor"@en ;
    rdfs:subClassOf life:LifecycleProcess .

life:AgingProcess a owl:Class ;
    rdfs:label "Aging process"@en ;
    rdfs:comment "A time-dependent post-creation process in which an entity evolves during storage, exposure, or operation, potentially changing its state."@en ;
    skos:example "composition"@en , "morphology"@en , "structure"@en , "optical properties"@en ;
    rdfs:subClassOf life:PostCreationProcess .

life:StorageAgingProcess a owl:Class ;
    rdfs:label "Storage aging process"@en ;
    rdfs:comment "An aging process in which an entity evolves over time while being stored under specified conditions."@en ;
    skos:example "atmosphere"@en , "humidity"@en , "temperature"@en , "pressure"@en ;
    skos:scopeNote
        """The storage duration is not one of these conditions: attach it with
        life:hasDuration on the process itself. The examples list the factors
        that are genuinely imposed during storage."""@en ;
    rdfs:subClassOf life:AgingProcess,
                    life:StorageProcess .

life:ExposureAgingProcess a owl:Class ;
    rdfs:label "Exposure aging process"@en ;
    rdfs:comment "An aging process in which an entity evolves over time while being exposed to an external factor."@en ;
    skos:example "environmental exposure"@en , "optical exposure"@en , "thermal exposure"@en , "chemical exposure"@en , "mechanical exposure"@en ;
    rdfs:subClassOf life:AgingProcess,
                    life:ExposureProcess .

life:OperationProcess a owl:Class ;
    rdfs:label "Operation process"@en ;
    rdfs:comment "A process in which an entity is used under functional working conditions."@en ;
    skos:example "illumination"@en , "biasing"@en , "cycling"@en , "charging"@en , "discharging"@en , "device operation"@en ;
    rdfs:subClassOf life:LifecycleProcess .

life:OperationalAgingProcess a owl:Class ;
    rdfs:label "Operational aging process"@en ;
    rdfs:comment "An aging process in which an entity evolves over time during operation or use."@en ;
    skos:example "cycling"@en , "illumination"@en , "biasing"@en ;
    rdfs:subClassOf life:AgingProcess,
                    life:OperationProcess .

#################################################################
# Quantity values, effects, and observation model
#################################################################

life:TimeQuantityValue a owl:Class ;
    rdfs:label "Time quantity value"@en ;
    rdfs:comment
        """A quantity value representing a time, duration, elapsed time,
        delay, lifetime, time scale, or entity age. Subclass of
        qudt:QuantityValue. Optional further subclassing under
        qqval:QualifiedQuantityValue is asserted by pergres."""@en ;
    rdfs:subClassOf qudt:QuantityValue .

life:TimeDependentEffect a owl:Class ;
    rdfs:label "Time-dependent effect"@en ;
    rdfs:comment "An effect associated with elapsed time during synthesis, storage, aging, exposure, or characterization."@en ;
    rdfs:subClassOf obs:Phenomenon .

life:AgingEffect a owl:Class ;
    rdfs:label "Aging effect"@en ;
    rdfs:comment "A time-dependent effect produced or observed after entity aging."@en ;
    rdfs:subClassOf life:TimeDependentEffect .

# StorageEffect is the only dedicated sibling narrowing AgingEffect by
# process kind; exposure/operational aging effects are covered generically
# by AgingEffect itself rather than by dedicated ExposureEffect/
# OperationalEffect siblings. Intentional (storage conditions warrant their
# own class; exposure/operational don't yet), not a gap to fill in by
# pattern-matching the process taxonomy below.
life:StorageEffect a owl:Class ;
    rdfs:label "Storage effect"@en ;
    rdfs:comment "A time-dependent effect associated with keeping an entity under specified storage conditions."@en ;
    rdfs:subClassOf life:TimeDependentEffect .

life:ObservableTemporalProperty a owl:Class ;
    rdfs:label "Observable temporal property"@en ;
    rdfs:comment "An observable property whose value is a time, duration, elapsed time, delay, lifetime, rate-related time scale, or entity age."@en ;
    rdfs:subClassOf sosa:ObservableProperty .

life:TemporalObservation a owl:Class ;
    rdfs:label "Temporal observation"@en ;
    rdfs:comment "A quantitative observation whose observed property is temporal and whose result is represented as a time quantity value."@en ;
    rdfs:subClassOf obs:QuantitativeObservation ,
        [
            a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom life:ObservableTemporalProperty
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty life:hasTemporalQuantityResult ;
            owl:someValuesFrom life:TimeQuantityValue
        ] .

life:EntityLifecycleState a owl:Class ;
    rdfs:label "Entity lifecycle state"@en ;
    rdfs:comment "A qualitative result describing the lifecycle status of an entity. Open vocabulary: domain ontologies add domain-specific states as siblings of the universal fresh/aged/stored trio defined here."@en ;
    skos:example "fresh"@en , "aged"@en , "stored"@en , "condition-specific aged"@en ;
    rdfs:subClassOf obs:QualitativeResult .

life:QualitativeEntityLifecycleObservation a owl:Class ;
    rdfs:label "Qualitative entity lifecycle observation"@en ;
    rdfs:comment
        """A qualitative observation of an entity-scoped temporal property whose
        result is a categorical lifecycle state such as fresh, aged or
        stored."""@en ;
    skos:scopeNote
        """Quantitative entity-scoped temporal observations (numeric entity age,
        say) are typed life:TemporalObservation instead. Observed-property scope
        (entity vs process) and result kind (quantitative vs qualitative) are
        independent axes, not one pair."""@en ;
    rdfs:subClassOf obs:QualitativeObservation ,
        [
            a owl:Restriction ;
            owl:onProperty sosa:observedProperty ;
            owl:someValuesFrom life:ObservableEntityTemporalProperty
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty life:hasEntityLifecycleStateResult ;
            owl:someValuesFrom life:EntityLifecycleState
        ] .

life:ObservableProcessTemporalProperty a owl:Class ;
    rdfs:label "Observable process temporal property"@en ;
    rdfs:comment "A temporal property describing the duration or elapsed time of a process or process step."@en ;
    skos:scopeNote
        """For a process time that is measured -- in-situ monitoring of how
        long a reaction took. A duration stated as a protocol parameter
        ("stirred for 2 h") is not an observation: attach it with
        life:hasDuration. An extension point; the collection declares no
        individuals of this class."""@en ;
    rdfs:subClassOf life:ObservableTemporalProperty .

life:ObservableEntityTemporalProperty a owl:Class ;
    rdfs:label "Observable entity temporal property"@en ;
    rdfs:comment
        """A temporal property describing the age, temporal status, or
        time-dependent condition of an entity."""@en ;
    skos:scopeNote
        """Entity-scoping and result kind are independent axes, so this class
        spans both. Its one individual, entityLifecycleStateProperty, is
        qualitative; a measured entity age may be minted here. A stated entity
        age is not an observation -- use life:hasEntityAge."""@en ;
    rdfs:subClassOf life:ObservableTemporalProperty .

life:ObservableTransientTemporalProperty a owl:Class ;
    rdfs:label "Observable transient temporal property"@en ;
    rdfs:comment "A temporal property characterizing an event-triggered, finely time-resolved transient response of a process or system, independent of measurement technique."@en ;
    rdfs:subClassOf life:ObservableTemporalProperty .

life:TimeConditionValue a owl:Class ;
    rdfs:label "Time condition value"@en ;
    rdfs:comment "A quantitative condition value carrying a time, used for temporal instrument settings such as pulse width or temporal resolution. It is also a time quantity value."@en ;
    skos:scopeNote
        """For temporal instrument settings, reached via
        obs:InstrumentConfiguration and obs:hasSetting. Storage duration,
        aging time, exposure duration, measurement delay and entity age are not
        conditions -- see life:hasDuration, life:hasObservationDelay and
        life:hasEntityAge."""@en ;
    rdfs:subClassOf obs:QuantitativeConditionValue,
                    life:TimeQuantityValue .

#################################################################
# Object properties
#################################################################

life:hasDuration a owl:ObjectProperty ;
    rdfs:label "has duration"@en ;
    rdfs:comment "Links a process to a time quantity value representing its duration."@en ;
    skos:scopeNote
        """The route for the stated extent of a process: "stirred for 2 h",
        "annealed 30 min", "stored 4-15 days". A duration is never a reified
        obs:Condition.

        Use life:hasEntityAge for an entity's age, life:hasObservationDelay for
        the delay at which an observation was taken, and
        life:hasTemporalQuantityResult when the time is a measured result
        (carrier lifetime, decay constant) rather than a stated protocol
        parameter."""@en ;
    rdfs:domain obs:Process ;
    rdfs:range life:TimeQuantityValue .

life:hasElapsedTime a owl:ObjectProperty ;
    rdfs:label "has elapsed time"@en ;
    rdfs:comment
        """Links an entity, process, or observation to the time elapsed since a
        relevant reference event."""@en ;
    skos:scopeNote
        """Carries no rdfs:domain: domain propagates through
        rdfs:subPropertyOf, and a domain here would conflict with
        life:hasObservationDelay, whose domain is obs:Observation."""@en ;
    rdfs:range life:TimeQuantityValue .

life:hasEntityAge a owl:ObjectProperty ;
    rdfs:label "has entity age"@en ;
    rdfs:comment "Links a concrete entity (sosa:FeatureOfInterest) to a time quantity value representing the time elapsed since its synthesis, fabrication, deposition, or another stated reference event."@en ;
    skos:scopeNote
        """The route for a stated entity age: "measured 3 days after
        synthesis", "2-week-old film". Never a reified obs:Condition. Use
        life:hasDuration when the time is the extent of a named process rather
        than the age of an entity; name the reference event with
        life:hasTemporalReferenceProcess."""@en ;
    rdfs:domain sosa:FeatureOfInterest ;
    rdfs:range life:TimeQuantityValue ;
    rdfs:subPropertyOf life:hasElapsedTime .

life:hasTemporalQuantityResult a owl:ObjectProperty ;
    rdfs:label "has temporal quantity result"@en ;
    rdfs:comment "Links a temporal observation to a time quantity value."@en ;
    skos:scopeNote
        """For a measured temporal quantity -- carrier lifetime, decay
        constant, relaxation or coherence time, energy-transfer time -- where
        the time is the outcome of the measurement. A stated protocol
        parameter ("stirred 2 h", "aged 4-15 days") is not a measurement: use
        life:hasDuration, life:hasEntityAge or life:hasObservationDelay.

        The subject is a life:TemporalObservation carrying a
        sosa:observedProperty, per the domain above."""@en ;
    rdfs:domain life:TemporalObservation ;
    rdfs:range life:TimeQuantityValue ;
    rdfs:subPropertyOf obs:hasQuantityResult .

life:hasEntityLifecycleStateResult a owl:ObjectProperty ;
    rdfs:label "has entity lifecycle state result"@en ;
    rdfs:comment "Links an entity lifecycle state observation to its entity lifecycle state result."@en ;
    rdfs:domain life:QualitativeEntityLifecycleObservation ;
    rdfs:range life:EntityLifecycleState ;
    rdfs:subPropertyOf obs:hasQualitativeResult .

life:hasObservationDelay a owl:ObjectProperty ;
    rdfs:label "has observation delay"@en ;
    rdfs:comment "Links an observation to a time quantity value representing the relative delay at which the observation result was recorded (e.g. 5 ps after excitation). Always a relative elapsed time, never an absolute wall-clock timestamp."@en ;
    skos:scopeNote
        """The route for a stated measurement delay, including pump-probe
        delay. Never a reified obs:Condition, and never a
        life:TemporalObservation of a "delay time" property: the delay is the
        coordinate at which the result was taken, not the result. What was
        measured at that delay is the observation's own
        obs:hasQuantityResult."""@en ;
    rdfs:domain obs:Observation ;
    rdfs:range life:TimeQuantityValue ;
    rdfs:subPropertyOf life:hasElapsedTime .

life:hasTemporalReferenceProcess a owl:ObjectProperty ;
    rdfs:label "has temporal reference process"@en ;
    rdfs:comment "Links a temporal value, observation, entity, or process to the process used as the reference point for elapsed time, such as synthesis, deposition, storage start, aging start, excitation, or measurement start."@en ;
    rdfs:range obs:Process .

life:hasStorageCondition a owl:ObjectProperty ;
    rdfs:label "has storage condition"@en ;
    rdfs:comment "Links a storage or aging process to a reified condition, such as atmosphere, pressure, humidity, or temperature."@en ;
    skos:scopeNote
        """Conditions only -- factors imposed on the entity while it is stored.
        The storage duration is not a condition: attach it to the process with
        life:hasDuration. A temporal factor on this property is rejected by
        observation-shapes.ttl."""@en ;
    rdfs:domain life:StorageProcess ;
    rdfs:range obs:Condition ;
    rdfs:subPropertyOf obs:hasProcessCondition .

life:hasTimeDependentEffect a owl:ObjectProperty ;
    rdfs:label "has time-dependent effect"@en ;
    rdfs:comment "Links a lifecycle process to an effect associated with elapsed time."@en ;
    rdfs:domain life:LifecycleProcess ;
    rdfs:range life:TimeDependentEffect .

life:affectsObservableProperty a owl:ObjectProperty ;
    rdfs:label "affects observable property"@en ;
    rdfs:comment "Links a time-dependent effect to the observable property whose value or qualitative state changes."@en ;
    rdfs:domain life:TimeDependentEffect ;
    rdfs:range sosa:ObservableProperty .

life:precedes a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    rdfs:comment
        """States that one process temporally precedes another, ending at or
        before the other begins."""@en ;
    skos:scopeNote
        """Minimal by design: process order without an OWL-Time import.
        rdfs:seeAlso is the alignment hook."""@en ;
    rdfs:domain obs:Process ;
    rdfs:range obs:Process ;
    owl:inverseOf life:follows ;
    rdfs:seeAlso <http://www.w3.org/2006/time#before> .

life:follows a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "follows"@en ;
    rdfs:comment "States that one process temporally follows another (begins at or after the other ends). Inverse of life:precedes."@en ;
    rdfs:domain obs:Process ;
    rdfs:range obs:Process ;
    rdfs:seeAlso <http://www.w3.org/2006/time#after> .

#################################################################
# Entity lifecycle state controlled vocabulary
#
# Universal trio only. Domain-specific storage/aging states are minted as
# siblings of this class in downstream domain ontologies.
#################################################################

life:freshEntityState a owl:NamedIndividual, life:EntityLifecycleState ;
    rdfs:label "fresh"@en ;
    skos:altLabel "day 0"@en, "pristine"@en, "as-synthesized"@en .

life:agedEntityState a owl:NamedIndividual, life:EntityLifecycleState ;
    rdfs:label "aged"@en .

life:storedEntityState a owl:NamedIndividual, life:EntityLifecycleState ;
    rdfs:label "stored"@en .

life:entityLifecycleStateProperty a owl:NamedIndividual, life:ObservableEntityTemporalProperty ;
    rdfs:label "entity lifecycle state"@en .
