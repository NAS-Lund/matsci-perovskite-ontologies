unit:A-PER-CentiM2 a qudt:Unit ;
    rdfs:label "Ampere per Square CentiMetre"@en,
        "Ampere per Square CentiMeter"@en-US ;
    qudt:applicableSystem sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:SI ;
    qudt:conversionMultiplier 10000.0 ;
    qudt:hasDimensionVector dimension:A0E1L-2I0M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:ElectricCurrentDensity ;
    qudt:symbol "A/cm2",
        "A/cm²" ;
    qudt:ucumCode "A.cm-2"^^qudt:UCUMcs,
        "A/cm2"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> ;
    skos:notation "A/cm2" .

unit:ANGSTROM a qudt:Unit ;
    rdfs:label "Angstrom"@en ;
    qudt:conversionMultiplier 0.0000000001 ;
    qudt:hasDimensionVector dimension:A0E0L1I0M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:Length ;
    qudt:scalingOf unit:M ;
    qudt:symbol "Angstrom",
        "angstrom",
        "Å" ;
    qudt:ucumCode "Ao"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> ;
    skos:notation "Angstrom",
        "angstrom" .

unit:ATM a qudt:Unit ;
    rdfs:label "Standard Atmosphere"@en ;
    qudt:applicableSystem sou:CGS ;
    qudt:conversionMultiplier 101325.0 ;
    qudt:hasDimensionVector dimension:A0E0L-1I0M1H0T-2D0 ;
    qudt:hasQuantityKind quantitykind:ForcePerArea,
        quantitykind:VaporPressure ;
    qudt:scalingOf unit:PA ;
    qudt:symbol "atm" ;
    qudt:ucumCode "atm"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> .

unit:CentiM a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "CentiMetre"@en,
        "CentiMeter"@en-US ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:SI ;
    qudt:conversionMultiplier 0.01 ;
    qudt:hasDimensionVector dimension:A0E0L1I0M0H0T0D0 ;
    qudt:hasQuantityKind quantitykind:Length ;
    qudt:prefix prefix:Centi ;
    qudt:scalingOf unit:M ;
    qudt:symbol "cm" ;
    qudt:ucumCode "cm"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> .

unit:CentiM2-PER-V-SEC a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Square CentiMetre per Volt Second"@en,
        "Square CentiMeter per Volt Second"@en-US ;
    qudt:applicableSystem sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:SI ;
    qudt:conversionMultiplier 0.0001 ;
    qudt:expression "$cm^2/V-s$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimension:A0E1L0I0M-1H0T2D0 ;
    qudt:hasQuantityKind quantitykind:Mobility ;
    qudt:symbol "cm2/(V·s)",
        "cm²/(V·s)",
        "cm²V⁻¹s⁻¹" ;
    qudt:ucumCode "cm2.V-1.s-1"^^qudt:UCUMcs,
        "cm2/(V.s)"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> ;
    skos:notation "cm2/(V·s)",
        "cm²V⁻¹s⁻¹" .

unit:DAY a qudt:Unit ;
    rdfs:label "Day"@en ;
    qudt:applicableSystem sou:CGS,
        sou:CGS-EMU,
        sou:CGS-GAUSS,
        sou:IMPERIAL,
        sou:SI,
        sou:USCS ;
    qudt:conversionMultiplier 86400.0 ;
    qudt:hasDimensionVector dimension:A0E0L0I0M0H0T1D0 ;
    qudt:hasQuantityKind quantitykind:BiodegredationHalfLife,
        quantitykind:FishBiotransformationHalfLife,
        quantitykind:Time ;
    qudt:scalingOf unit:SEC ;
    qudt:symbol "d" ;
    qudt:ucumCode "d"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> .

unit:DEG a qudt:Unit ;
    rdfs:label "Degree"@en ;
    qudt:applicableSystem sou:ASU,
        sou:CGS,
        sou:CGS-EMU,
        sou:CGS-ESU,
        sou:CGS-GAUSS,
        sou:IMPERIAL,
        sou:PLANCK,
        sou:SI ;
    qudt:conversionMultiplier 0.0174532925 ;
    qudt:hasDimensionVector dimension:A0E0L0I0M0H0T0D1 ;
    qudt:hasQuantityKind quantitykind:Angle,
        quantitykind:PlaneAngle ;
    qudt:scalingOf unit:RAD ;
    qudt:symbol "deg",
        "°" ;
    qudt:ucumCode "deg"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> ;
    skos:notation "deg" .

unit:DEG_C a qudt:DerivedUnit,
        qudt:Unit ;
    rdfs:label "Degree Celsius"@en ;
    qudt:applicableSystem sou:CGS,
        sou:SI ;
    qudt:conversionMultiplier 1.0 ;
    qudt:conversionOffset 273.15 ;
    qudt:expression "$degC$"^^qudt:LatexString ;
    qudt:hasDimensionVector dimension:A0E0L0I0M0H1T0D0 ;
    qudt:hasQuantityKind quantitykind:BoilingPoint,
        quantitykind:FlashPoint,
        quantitykind:MeltingPoint,
        quantitykind:Temperature ;
    qudt:scalingOf unit:K ;
    qudt:symbol "Celsius",
        "deg C",
        "degC",
        "°C" ;
    qudt:ucumCode "Cel"^^qudt:UCUMcs ;
    rdfs:isDefinedBy <http://qudt.org/3.1.4/vocab/unit> ;
    skos:notation "Celsius",
        "deg C",
        "degC" .

