@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obs:     <https://growgraph.dev/ontologies/observation#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix pergres: <https://growgraph.dev/ontologies/pergres#> .
@prefix qqval:   <https://growgraph.dev/ontologies/qqval#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix life:    <https://growgraph.dev/ontologies/lifecycle#> .


<https://growgraph.dev/ontologies/pergres> a owl:Ontology ;
    rdfs:label "pergres"@en ;
    dcterms:creator "growgraph.dev" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment
        """Bridge ontology for the Pergres project: asserts the cross-module
        policy that quantitative observation results and temporal quantity
        values are qqval-qualified.

        Leaves qqval, observation, and lifecycle
        free of mutual coupling. Consumers that want qqval-qualified
        results (e.g. matsci) import this module; consumers that
        only need bare qudt:QuantityValue results import observation /
        lifecycle alone.

        Axioms:
          • obs:hasQuantityResult range → qqval:QualifiedQuantityValue
          • obs:QuantitativeObservation requires some sosa:hasResult that
            is a qqval:QualifiedQuantityValue
          • life:TimeQuantityValue ⊑ qqval:QualifiedQuantityValue"""@en ;
    owl:versionIRI <https://growgraph.dev/ontologies/pergres/1.1.0> ;
    owl:imports
        <https://growgraph.dev/ontologies/qqval> ,
        <https://growgraph.dev/ontologies/observation> ,
        <https://growgraph.dev/ontologies/lifecycle> ;
    owl:versionInfo "1.1.0" .

#################################################################
# qqval-qualification policy for observation results
#################################################################

obs:hasQuantityResult rdfs:range qqval:QualifiedQuantityValue .

obs:QuantitativeObservation rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty sosa:hasResult ;
        owl:someValuesFrom qqval:QualifiedQuantityValue
    ] .

#################################################################
# qqval-qualification policy for temporal quantity values
#################################################################

life:TimeQuantityValue rdfs:subClassOf qqval:QualifiedQuantityValue .
